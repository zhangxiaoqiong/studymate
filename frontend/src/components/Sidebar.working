import React, { useState, useEffect } from 'react'
import ReactMarkdown from 'react-markdown'
import remarkGfm from 'remark-gfm'
import { askFollowupQuestion, askFollowupQuestionStream } from '../services/api'

const Sidebar = ({
  keyword,
  explanation,
  loading,
  onClose,
  isSaved,
  savedExplanations,
  onSave,
  onDelete,
  onRefresh,
  onUpdateSavedExplanation,
  width = 700,
  onResizeStart,
}) => {
  const [mode, setMode] = useState(isSaved ? 'saved' : 'new')
  const [selectedSavedKeyword, setSelectedSavedKeyword] = useState(null)
  const [askingQuestion, setAskingQuestion] = useState(false)
  const [questionInput, setQuestionInput] = useState('')
  const [showConversations, setShowConversations] = useState(false)
  const [showSavedList, setShowSavedList] = useState(false)
  const [regeneratingConvIndex, setRegeneratingConvIndex] = useState(null)
  const [streamingAnswer, setStreamingAnswer] = useState('')  // 实时流式答案
  const [streamingExplanation, setStreamingExplanation] = useState('')  // 实时流式解释

  // 当keyword改变时，自动更新mode和selectedSavedKeyword
  useEffect(() => {
    if (savedExplanations[keyword]) {
      // 如果该关键词已保存，进入已保存模式并选中它
      setMode('saved')
      setSelectedSavedKeyword(keyword)
    } else {
      // 否则进入新生成模式
      setMode('new')
      setSelectedSavedKeyword(null)
    }
  }, [keyword, savedExplanations])

  const formatDate = (timestamp) => {
    const now = Date.now()
    const diff = now - timestamp
    const hours = Math.floor(diff / (1000 * 60 * 60))
    const days = Math.floor(diff / (1000 * 60 * 60 * 24))

    if (hours < 1) return '刚刚'
    if (hours < 24) return `${hours}小时前`
    if (days < 7) return `${days}天前`
    return new Date(timestamp).toLocaleDateString('zh-CN')
  }

  const getSavedExplanation = () => {
    if (mode === 'saved') {
      const savedKey = selectedSavedKeyword || keyword
      return savedExplanations[savedKey]?.explanation
    }
    return explanation
  }

  const getDisplayKeyword = () => {
    if (mode === 'saved' && selectedSavedKeyword) {
      return selectedSavedKeyword
    }
    return keyword
  }

  const handleSaveClick = () => {
    onSave(keyword, explanation)
    setMode('saved')
    setSelectedSavedKeyword(keyword)
  }

  const handleDeleteClick = () => {
    const keywordToDelete = mode === 'saved' ? (selectedSavedKeyword || keyword) : keyword
    onDelete(keywordToDelete)
    if (mode === 'saved') {
      const remainingKeywords = Object.keys(savedExplanations).filter(k => k !== keywordToDelete)
      if (remainingKeywords.length > 0) {
        setSelectedSavedKeyword(remainingKeywords[0])
      } else {
        setMode('new')
        setSelectedSavedKeyword(null)
      }
    }
  }

  const handleRefreshClick = () => {
    onRefresh(keyword)
    setMode('new')
    setSelectedSavedKeyword(null)
  }

  const handleAskQuestion = async () => {
    if (!questionInput.trim()) return

    const currentKeyword = selectedSavedKeyword || keyword
    const savedExplanation = savedExplanations[currentKeyword]?.explanation || currentExplanation

    setAskingQuestion(true)
    setStreamingAnswer('')  // 清空之前的流式答案
    try {
      const result = await askFollowupQuestionStream(
        currentKeyword, 
        savedExplanation, 
        questionInput,
        (chunk) => {
          // 实时更新UI中的流式答案
          setStreamingAnswer(prev => prev + chunk)
        }
      )

      // 更新savedExplanation中的conversations数组
      const updatedExplanation = {
        ...savedExplanations[currentKeyword],
        conversations: [
          ...(savedExplanations[currentKeyword]?.conversations || []),
          {
            question: questionInput,
            answer: result.answer,
            askedAt: Date.now(),
          },
        ],
      }

      // 通知父组件更新savedExplanation
      onUpdateSavedExplanation(currentKeyword, updatedExplanation)
      setQuestionInput('')
      setStreamingAnswer('')  // 清空流式答案
    } catch (error) {
      console.error('问答请求详情:', error.response?.data || error.message)
      alert('提问失败：' + (error.response?.data?.detail || error.message || '请稍后重试'))
      setStreamingAnswer('')  // 错误时清空
    } finally {
      setAskingQuestion(false)
    }
  }

  const handleRegenerateConversation = async (convIndex) => {
    const currentKeyword = selectedSavedKeyword || keyword
    const conversation = savedExplanations[currentKeyword]?.conversations[convIndex]
    if (!conversation) return

    setRegeneratingConvIndex(convIndex)
    setStreamingAnswer('')  // 清空显示区域
    try {
      const savedExplanation = savedExplanations[currentKeyword]?.explanation || currentExplanation
      const result = await askFollowupQuestionStream(
        currentKeyword, 
        savedExplanation, 
        conversation.question,
        (chunk) => {
          // 只更新流式显示，不更新savedExplanations
          setStreamingAnswer(prev => prev + chunk)
        }
      )

      // 流式完成后，一次性更新savedExplanations
      const updatedConversations = [...(savedExplanations[currentKeyword]?.conversations || [])]
      updatedConversations[convIndex] = {
        ...conversation,
        answer: result.answer,
        askedAt: Date.now(),
      }

      const updatedExplanation = {
        ...savedExplanations[currentKeyword],
        conversations: updatedConversations,
      }

      onUpdateSavedExplanation(currentKeyword, updatedExplanation)
      setStreamingAnswer('')  // 完成后清空流式显示
    } catch (error) {
      console.error('重新生成失败:', error.response?.data || error.message)
      alert('重新生成失败：' + (error.response?.data?.detail || error.message || '请稍后重试'))
      setStreamingAnswer('')
    } finally {
      setRegeneratingConvIndex(null)
    }
  }

  const handleDeleteConversation = (convIndex) => {
    const currentKeyword = selectedSavedKeyword || keyword
    if (!confirm('确定要删除这条对话吗？')) return

    const updatedConversations = savedExplanations[currentKeyword]?.conversations.filter((_, idx) => idx !== convIndex) || []
    const updatedExplanation = {
      ...savedExplanations[currentKeyword],
      conversations: updatedConversations,
    }

    onUpdateSavedExplanation(currentKeyword, updatedExplanation)
  }

  const currentExplanation = getSavedExplanation()
  const displayKeyword = getDisplayKeyword()

  return (
    <div
      className="sidebar-enter fixed right-0 top-0 h-screen bg-white shadow-2xl z-50 flex flex-col border-l border-gray-200 group"
      style={{ width: `${width}px` }}
    >
      {/* 拖动调整宽度的分隔线 */}
      {onResizeStart && (
        <div
          onMouseDown={(e) => {
            e.preventDefault()
            onResizeStart(e.clientX)
          }}
          className="absolute left-0 top-0 w-1 h-full bg-gray-300 hover:bg-blue-500 cursor-col-resize transition-colors hover:w-1.5"
          title="拖动调整宽度"
        />
      )}
      {/* 头部 */}
      <div className="flex items-center justify-between p-6 border-b border-gray-200 bg-gradient-to-r from-blue-50 to-purple-50">
        <div>
          <h2 className="text-xl font-bold text-gray-900">{displayKeyword}</h2>
          <p className="text-sm text-gray-600 mt-1">
            {mode === 'saved' ? '已保存的解释' : '详细解释'}
          </p>
        </div>
        <div className="flex items-center gap-1">
          {!loading && currentExplanation && (
            <button
              onClick={() => {
                const text = `${displayKeyword}\n\n${currentExplanation}`
                navigator.clipboard.writeText(text).then(() => {
                  alert('已复制到剪贴板')
                })
              }}
              className="text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded-full p-2 transition-colors"
              title="复制解释"
            >
              <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </button>
          )}
          <button
            onClick={handleRefreshClick}
            disabled={loading}
            className="text-gray-400 hover:text-green-600 hover:bg-green-50 disabled:opacity-50 rounded-full p-2 transition-colors"
            title="刷新"
          >
            <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </button>
          {mode === 'new' ? (
            <button
              onClick={handleSaveClick}
              disabled={loading || !explanation}
              className="text-gray-400 hover:text-blue-600 hover:bg-blue-50 disabled:opacity-50 rounded-full p-2 transition-colors"
              title="保存"
            >
              <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" />
              </svg>
            </button>
          ) : (
            <button
              onClick={handleDeleteClick}
              className="text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-full p-2 transition-colors"
              title="删除"
            >
              <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          )}
          <button
            onClick={onClose}
            className="text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-full p-2 transition-colors"
            title="关闭"
          >
            <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      {/* 内容区域 */}
      <div className="flex-1 overflow-y-auto p-6">
        {mode === 'saved' ? (
          // 已保存列表模式
          <div className="space-y-3">
            {Object.keys(savedExplanations).length === 0 ? (
              <div className="text-center text-gray-500 py-8">
                <p>暂无已保存的解释</p>
              </div>
            ) : (
              <div className="space-y-2">
                <p className="text-xs font-semibold text-gray-600 uppercase">已保存的解释列表</p>
                {Object.entries(savedExplanations).map(([kw, data]) => (
                  <button
                    key={kw}
                    onClick={() => setSelectedSavedKeyword(kw)}
                    className={`w-full text-left p-3 rounded-lg border transition-all ${
                      selectedSavedKeyword === kw
                        ? 'bg-blue-50 border-blue-300'
                        : 'bg-gray-50 border-gray-200 hover:border-gray-300'
                    }`}
                  >
                    <div className="flex items-start justify-between">
                      <div className="flex-1">
                        <div className="font-medium text-gray-900">{kw}</div>
                        <div className="text-xs text-gray-500 mt-1">
                          于 {formatDate(data.savedAt)} 保存
                        </div>
                      </div>
                      {selectedSavedKeyword === kw && (
                        <button
                          onClick={(e) => {
                            e.stopPropagation()
                            onDelete(kw)
                            const remainingKeywords = Object.keys(savedExplanations).filter(k => k !== kw)
                            if (remainingKeywords.length > 0) {
                              setSelectedSavedKeyword(remainingKeywords[0])
                            } else {
                              setMode('new')
                              setSelectedSavedKeyword(null)
                            }
                          }}
                          className="ml-2 text-red-400 hover:text-red-600 transition-colors"
                          title="删除"
                        >
                          <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      )}
                    </div>
                  </button>
                ))}
              </div>
            )}

            {/* 已保存解释内容 */}
            {selectedSavedKeyword && currentExplanation && (
              <div className="mt-6 pt-6 border-t border-gray-200">
                <div className="bg-blue-50 rounded-lg p-5 border border-blue-200 mb-4">
                  <div className="prose prose-base max-w-none text-gray-800">
                    <ReactMarkdown
                      remarkPlugins={[remarkGfm]}
                      components={{
                        h1: ({node, ...props}) => <h1 className="text-2xl font-bold text-gray-900 mt-4 mb-3" {...props} />,
                        h2: ({node, ...props}) => <h2 className="text-xl font-bold text-gray-900 mt-4 mb-3" {...props} />,
                        h3: ({node, ...props}) => <h3 className="text-lg font-bold text-gray-900 mt-3 mb-2" {...props} />,
                        p: ({node, ...props}) => <p className="text-base text-gray-800 my-3 leading-relaxed" {...props} />,
                        strong: ({node, ...props}) => <strong className="font-bold text-gray-900" {...props} />,
                        em: ({node, ...props}) => <em className="italic text-gray-800" {...props} />,
                        ul: ({node, ...props}) => <ul className="list-disc pl-6 text-base text-gray-800 my-3 space-y-1" {...props} />,
                        ol: ({node, ...props}) => <ol className="list-decimal pl-6 text-base text-gray-800 my-3 space-y-1" {...props} />,
                        li: ({node, ...props}) => <li className="text-base text-gray-800" {...props} />,
                        code: ({node, inline, ...props}) =>
                          inline ? (
                            <code className="bg-gray-200 text-gray-900 px-2 py-1 rounded text-sm font-mono" {...props} />
                          ) : (
                            <code className="bg-gray-200 text-gray-900 px-3 py-2 rounded block text-sm font-mono my-3 overflow-x-auto" {...props} />
                          ),
                        blockquote: ({node, ...props}) => <blockquote className="border-l-4 border-blue-400 pl-4 text-base text-gray-700 italic my-3" {...props} />,
                        a: ({node, ...props}) => <a className="text-blue-600 hover:underline font-medium" {...props} />,
                      }}
                    >
                      {currentExplanation}
                    </ReactMarkdown>
                  </div>
                </div>

                {/* 对话历史 */}
                {savedExplanations[selectedSavedKeyword]?.conversations && savedExplanations[selectedSavedKeyword].conversations.length > 0 && (
                  <div className="mb-4">
                    <button
                      onClick={() => setShowConversations(!showConversations)}
                      className="flex items-center gap-2 text-sm font-medium text-blue-600 hover:text-blue-700 mb-3"
                    >
                      <svg className={`w-4 h-4 transition-transform ${showConversations ? 'rotate-180' : ''}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                      </svg>
                      💬 {savedExplanations[selectedSavedKeyword].conversations.length} 个后续问题
                    </button>

                    {showConversations && (
                      <div className="space-y-3 mb-4">
                        {savedExplanations[selectedSavedKeyword].conversations.map((conv, idx) => (
                          <div key={idx} className="bg-gray-50 rounded-lg p-4 border border-gray-200">
                            {/* 问题部分 */}
                            <div className="mb-3">
                              <div className="flex items-start justify-between gap-2">
                                <div className="flex-1">
                                  <p className="text-sm font-medium text-gray-700 mb-1">🙋 你的问题：</p>
                                  <p className="text-sm text-gray-700">{conv.question}</p>
                                  <p className="text-xs text-gray-500 mt-1">{formatDate(conv.askedAt)}</p>
                                </div>
                                {/* 操作按钮 */}
                                <div className="flex gap-1">
                                  <button
                                    onClick={() => handleRegenerateConversation(idx)}
                                    disabled={regeneratingConvIndex === idx}
                                    className="p-1 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded transition-colors disabled:opacity-50"
                                    title="重新生成答案"
                                  >
                                    {regeneratingConvIndex === idx ? (
                                      <svg className="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                      </svg>
                                    ) : (
                                      <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                      </svg>
                                    )}
                                  </button>
                                  <button
                                    onClick={() => handleDeleteConversation(idx)}
                                    className="p-1 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded transition-colors"
                                    title="删除对话"
                                  >
                                    <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                  </button>
                                </div>
                              </div>
                            </div>
                            {/* 答案 */}
                            <div className="bg-blue-50 rounded p-3 border-l-2 border-blue-400">
                              <p className="text-sm font-medium text-gray-700 mb-2">
                                🤖 AI 回答{regeneratingConvIndex === idx ? '（流式更新中...）' : '：'}
                              </p>
                              {regeneratingConvIndex === idx && streamingAnswer ? (
                                // 重新生成时，显示流式内容
                                <div className="text-sm text-gray-700 whitespace-pre-wrap break-words font-mono mb-3 pb-3 border-b border-blue-200">
                                  {streamingAnswer}
                                  <span className="inline-block animate-pulse ml-1">▌</span>
                                </div>
                              ) : null}
                              <div className="text-sm text-gray-700 prose-sm max-w-none">
                                <ReactMarkdown
                                  remarkPlugins={[remarkGfm]}
                                  components={{
                                    p: ({node, ...props}) => <p className="text-sm text-gray-700 my-1" {...props} />,
                                    strong: ({node, ...props}) => <strong className="font-bold text-gray-900" {...props} />,
                                    em: ({node, ...props}) => <em className="italic" {...props} />,
                                    ul: ({node, ...props}) => <ul className="list-disc pl-5 text-sm text-gray-700 my-1 space-y-0" {...props} />,
                                    ol: ({node, ...props}) => <ol className="list-decimal pl-5 text-sm text-gray-700 my-1 space-y-0" {...props} />,
                                    li: ({node, ...props}) => <li className="text-sm text-gray-700" {...props} />,
                                    code: ({node, inline, ...props}) =>
                                      inline ? (
                                        <code className="bg-gray-200 text-gray-900 px-1 py-0 rounded text-xs font-mono" {...props} />
                                      ) : (
                                        <code className="bg-gray-200 text-gray-900 px-2 py-1 rounded block text-xs font-mono my-1" {...props} />
                                      ),
                                  }}
                                >
                                  {conv.answer}
                                </ReactMarkdown>
                              </div>
                            </div>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                )}

                {/* 流式答案显示区域 - 使用固定高度容器 */}
                {(streamingAnswer || askingQuestion) && (
                  <div className="mb-4 p-3 bg-blue-50 rounded border-l-4 border-blue-400 max-h-48 overflow-y-auto">
                    <p className="text-sm font-medium text-gray-700 mb-2">🤖 AI 回答中...</p>
                    <div className="text-sm text-gray-700 whitespace-pre-wrap break-words font-mono leading-relaxed">
                      {streamingAnswer}
                      {askingQuestion && <span className="inline-block animate-pulse ml-1">▌</span>}
                    </div>
                  </div>
                )}

                {/* 提问输入框 */}
                <div className="border-t border-gray-200 pt-4">
                  <div className="space-y-2">
                    <label className="block text-sm font-medium text-gray-700">📝 有问题吗？</label>
                    <div className="flex gap-2">
                      <input
                        type="text"
                        value={questionInput}
                        onChange={(e) => setQuestionInput(e.target.value)}
                        onKeyPress={(e) => e.key === 'Enter' && !askingQuestion && handleAskQuestion()}
                        placeholder="输入你的问题..."
                        disabled={askingQuestion}
                        className="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-200 outline-none transition-colors disabled:bg-gray-100"
                      />
                      <button
                        onClick={handleAskQuestion}
                        disabled={askingQuestion || !questionInput.trim()}
                        className="px-3 py-2 bg-blue-600 hover:bg-blue-700 disabled:bg-gray-400 text-white rounded-lg transition-colors font-medium text-sm flex items-center gap-1"
                      >
                        {askingQuestion ? (
                          <>
                            <svg className="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                            </svg>
                            回答中
                          </>
                        ) : (
                          <>
                            <span>🚀</span>
                            <span>提问</span>
                          </>
                        )}
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>
        ) : (
          // 新生成模式
          <>
            {loading || explanation ? (
              <div className="space-y-4">
                {/* Markdown 解释内容 */}
                <div className="bg-blue-50 rounded-lg p-5 border border-blue-200 min-h-32">
                  {loading && !explanation ? (
                    <div className="flex items-center justify-center h-32">
                      <div className="text-center">
                        <div className="inline-block h-8 w-8 border-4 border-gray-300 border-t-blue-500 rounded-full animate-spin mb-2"></div>
                        <p className="text-gray-600 font-medium text-sm">AI 正在思考...</p>
                      </div>
                    </div>
                  ) : (
                    <div className="prose prose-base max-w-none text-gray-800">
                      <ReactMarkdown
                      remarkPlugins={[remarkGfm]}
                      components={{
                        h1: ({node, ...props}) => <h1 className="text-2xl font-bold text-gray-900 mt-4 mb-3" {...props} />,
                        h2: ({node, ...props}) => <h2 className="text-xl font-bold text-gray-900 mt-4 mb-3" {...props} />,
                        h3: ({node, ...props}) => <h3 className="text-lg font-bold text-gray-900 mt-3 mb-2" {...props} />,
                        p: ({node, ...props}) => <p className="text-base text-gray-800 my-3 leading-relaxed" {...props} />,
                        strong: ({node, ...props}) => <strong className="font-bold text-gray-900" {...props} />,
                        em: ({node, ...props}) => <em className="italic text-gray-800" {...props} />,
                        ul: ({node, ...props}) => <ul className="list-disc pl-6 text-base text-gray-800 my-3 space-y-1" {...props} />,
                        ol: ({node, ...props}) => <ol className="list-decimal pl-6 text-base text-gray-800 my-3 space-y-1" {...props} />,
                        li: ({node, ...props}) => <li className="text-base text-gray-800" {...props} />,
                        code: ({node, inline, ...props}) =>
                          inline ? (
                            <code className="bg-gray-200 text-gray-900 px-2 py-1 rounded text-sm font-mono" {...props} />
                          ) : (
                            <code className="bg-gray-200 text-gray-900 px-3 py-2 rounded block text-sm font-mono my-3 overflow-x-auto" {...props} />
                          ),
                        blockquote: ({node, ...props}) => <blockquote className="border-l-4 border-blue-400 pl-4 text-base text-gray-700 italic my-3" {...props} />,
                        a: ({node, ...props}) => <a className="text-blue-600 hover:underline font-medium" {...props} />,
                      }}
                    >
                      {explanation}
                      </ReactMarkdown>
                    </div>
                  )}
                </div>

                {/* 底部提示 */}
                {!loading && explanation && (
                  <div className="bg-green-50 rounded-lg p-3 border border-green-200 text-xs text-green-700">
                    💡 满意的话点击头部的 📄 保存按钮收藏，或点击 🔄 刷新重新生成
                  </div>
                )}
              </div>
            ) : (
              <div className="flex items-center justify-center h-full text-center">
                <div>
                  <p className="text-gray-500 text-lg">选择关键词</p>
                  <p className="text-gray-400 text-sm mt-2">点击文档中的关键词查看解释</p>
                </div>
              </div>
            )}
          </>
        )}
      </div>
    </div>
  )
}

export default Sidebar
